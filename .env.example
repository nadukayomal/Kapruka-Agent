# =============================================================================
# Kapruka Gift Agent — environment template
# Copy this file to `.env` and fill in values. Never commit real secrets.
# =============================================================================

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# LLM (OpenAI-compatible). Required for Phases 4–6.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Token budgets
MAX_CONTEXT_TOKENS=8000
MAX_COMPLETION_TOKENS=1024

# Qdrant (Phase 3). Use local Docker or Qdrant Cloud.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kapruka_catalog
QDRANT_MEMORY_COLLECTION=kapruka_memory

# Paths (relative to project root unless absolute)
CATALOG_PATH=data/catalog.json
RECIPIENT_PROFILES_DIR=data/recipient_profiles
SAMPLE_CONVERSATIONS_DIR=data/sample_conversations

# Crawler (Phase 2)
KAPRUKA_BASE_URL=https://www.kapruka.com
CRAWLER_HEADLESS=true
CRAWLER_MAX_PAGES=50
CRAWLER_REQUEST_TIMEOUT_MS=30000
